{
  "name": "repopilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "snapshots": "node scripts/build-snapshots.mjs && node scripts/build-comparison.mjs",
    "dev": "npm run snapshots && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run snapshots && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:snapshots": "node --test scripts/build-snapshots.test.mjs scripts/run-detail.test.mjs scripts/build-comparison.test.mjs"
  },
  "dependencies": {
    "element-plus": "^2.11.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.1.0"
  }
}
